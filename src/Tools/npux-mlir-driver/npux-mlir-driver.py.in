#!/usr/bin/env python3

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile


DRIVER_VERSION = "npux-mlir-driver 0.3"
SOURCE_ROOT = Path("@ONNX_MLIR_SRC_ROOT@").resolve()
BUILD_ROOT = Path("@CMAKE_BINARY_DIR@").resolve()
NPUX_EP_ROOT = SOURCE_ROOT.parents[1]
NPUX_API_HEADER = NPUX_EP_ROOT / "runtime" / "npux_compiled_module_api.h"
COMPILE_MANIFEST_SCHEMA = "npux-compile-manifest-v2"


def resolve_onnx_mlir_binary() -> Path:
    candidates = [
        Path(sys.argv[0]).resolve().parent / "onnx-mlir",
        BUILD_ROOT / "bin" / "onnx-mlir",
        BUILD_ROOT / "Release" / "bin" / "onnx-mlir",
        BUILD_ROOT / "Debug" / "bin" / "onnx-mlir",
        BUILD_ROOT / "RelWithDebInfo" / "bin" / "onnx-mlir",
        BUILD_ROOT / "MinSizeRel" / "bin" / "onnx-mlir",
    ]
    for candidate in candidates:
        if candidate.is_file():
            return candidate
    raise FileNotFoundError("unable to locate sibling onnx-mlir binary")


def resolve_libomp_runtime() -> Path | None:
    candidates = [
        BUILD_ROOT / "Release" / "lib" / "libompruntime.so",
        BUILD_ROOT / "lib" / "libompruntime.so",
        BUILD_ROOT / "src" / "Runtime" / "omp" / "openmp-build" / "runtime" / "src" / "libomp.so",
    ]
    for candidate in candidates:
        if candidate.is_file():
            return candidate
    return None


def resolve_cruntime_archive() -> Path | None:
    candidates = [
        BUILD_ROOT / "Release" / "lib" / "libcruntime.a",
        BUILD_ROOT / "lib" / "libcruntime.a",
    ]
    for candidate in candidates:
        if candidate.is_file():
            return candidate
    return None


def resolve_cxx() -> str:
    env_cxx = os.environ.get("CXX")
    if env_cxx:
        return env_cxx
    for candidate in ("c++", "g++", "clang++"):
        resolved = shutil.which(candidate)
        if resolved:
            return resolved
    raise FileNotFoundError("unable to locate a host C++ compiler")


def write_log_header(log_file: Path, title: str, content: str) -> None:
    with log_file.open("a", encoding="utf-8") as f:
        f.write(f"== {title} ==\n")
        f.write(content)
        if not content.endswith("\n"):
            f.write("\n")


def run_command(args, log_file: Path) -> subprocess.CompletedProcess:
    proc = subprocess.run(args, capture_output=True, text=True)
    write_log_header(log_file, "COMMAND", " ".join(str(arg) for arg in args))
    if proc.stdout:
        write_log_header(log_file, "STDOUT", proc.stdout)
    if proc.stderr:
        write_log_header(log_file, "STDERR", proc.stderr)
    return proc


def locate_generated_object(object_base: Path) -> Path:
    candidates = [
        Path(str(object_base) + ".o"),
        Path(str(object_base) + ".obj"),
    ]
    for candidate in candidates:
        if candidate.is_file():
            return candidate
    raise FileNotFoundError(f"unable to locate generated object for base '{object_base}'")


def discover_direct_entry_symbol(model_object: Path, log_file: Path) -> str:
    proc = run_command(["nm", str(model_object)], log_file)
    if proc.returncode != 0:
        raise RuntimeError(f"failed to inspect generated object '{model_object}'")

    matches = []
    for line in proc.stdout.splitlines():
        parts = line.split()
        if len(parts) < 3:
            continue
        symbol = parts[-1]
        if symbol.startswith("_mlir_ciface_main_graph"):
            matches.append(symbol)
    if len(matches) != 1:
        raise RuntimeError(
            f"expected exactly one direct ABI entry symbol in '{model_object}', found {matches}"
        )
    return matches[0]


def object_requires_openmp(model_object: Path, log_file: Path) -> bool:
    proc = run_command(["nm", "-u", str(model_object)], log_file)
    if proc.returncode != 0:
        raise RuntimeError(f"failed to inspect undefined symbols for '{model_object}'")
    return any("__kmpc_" in line or " omp_" in line for line in proc.stdout.splitlines())


def stage_shared_runtime(runtime_path: Path, output_dir: Path) -> Path:
    digest = hashlib.sha256(runtime_path.read_bytes()).hexdigest()
    artifact_root = output_dir.parent.parent
    staged_dir = artifact_root / "shared" / "omp" / digest
    staged_dir.mkdir(parents=True, exist_ok=True)
    staged_path = staged_dir / "libomp.so"
    if not staged_path.exists():
        shutil.copy2(runtime_path, staged_path)
    return staged_path.resolve()


def sanitize_cpp_identifier(name: str) -> str:
    result = []
    for ch in name:
        if ch.isalnum():
            result.append(ch)
        else:
            result.append("_")
    identifier = "".join(result).strip("_")
    if not identifier:
        identifier = "symbol"
    if identifier[0].isdigit():
        identifier = f"_{identifier}"
    return identifier


def cpp_type_for_onnx_type(element_type: int) -> str:
    mapping = {
        1: "float",
        2: "uint8_t",
        3: "int8_t",
        4: "uint16_t",
        5: "int16_t",
        6: "int32_t",
        7: "int64_t",
        9: "bool",
        10: "uint16_t",
        11: "double",
        12: "uint32_t",
        13: "uint64_t",
        16: "uint16_t",
    }
    if element_type not in mapping:
        raise ValueError(f"unsupported ONNX tensor element type {element_type} for host-sim direct ABI")
    return mapping[element_type]


def emit_shape_array(name: str, shape: list[int]) -> str:
    if not shape:
        return f"constexpr std::array<int64_t, 0> {name}{{}};\n"
    values = ", ".join(str(dim) for dim in shape)
    return f"constexpr std::array<int64_t, {len(shape)}> {name}{{{{{values}}}}};\n"


def extract_string_array_attribute(attr_block: str, attr_name: str) -> list[str]:
    match = re.search(rf"{attr_name}\s*=\s*\[(.*?)\]", attr_block, re.S)
    if match is None:
        return []
    return re.findall(r'"([^"]+)"', match.group(1))


def skip_whitespace(text: str, index: int) -> int:
    while index < len(text) and text[index].isspace():
        index += 1
    return index


def find_matching_block(text: str, start: int, open_char: str, close_char: str) -> int:
    depth = 0
    in_string = False
    escape = False
    for index in range(start, len(text)):
        ch = text[index]
        if in_string:
            if escape:
                escape = False
            elif ch == "\\":
                escape = True
            elif ch == '"':
                in_string = False
            continue
        if ch == '"':
            in_string = True
            continue
        if ch == open_char:
            depth += 1
            continue
        if ch == close_char:
            depth -= 1
            if depth == 0:
                return index
    raise RuntimeError(f"unterminated block starting with '{open_char}'")


def extract_single_result_section(text: str, start: int) -> tuple[str, int]:
    angle_depth = 0
    paren_depth = 0
    square_depth = 0
    in_string = False
    escape = False
    index = start
    while index < len(text):
        ch = text[index]
        if in_string:
            if escape:
                escape = False
            elif ch == "\\":
                escape = True
            elif ch == '"':
                in_string = False
        else:
            if ch == '"':
                in_string = True
            elif ch == "<":
                angle_depth += 1
            elif ch == ">":
                angle_depth = max(0, angle_depth - 1)
            elif ch == "(":
                paren_depth += 1
            elif ch == ")":
                paren_depth = max(0, paren_depth - 1)
            elif ch == "[":
                square_depth += 1
            elif ch == "]":
                square_depth = max(0, square_depth - 1)
            elif ch.isspace() and angle_depth == 0 and paren_depth == 0 and square_depth == 0:
                break
        index += 1

    section_end = index
    index = skip_whitespace(text, index)
    if index < len(text) and text[index] == "{":
        section_end = find_matching_block(text, index, "{", "}") + 1
    return text[start:section_end], section_end


def extract_runtime_tensor_names(input_mlir_path: Path) -> tuple[list[str], list[str]]:
    text = input_mlir_path.read_text(encoding="utf-8")
    main_graph_index = text.find("func.func @main_graph")
    if main_graph_index < 0:
        raise RuntimeError(f"unable to locate main_graph signature in '{input_mlir_path}'")

    inputs_begin = text.find("(", main_graph_index)
    if inputs_begin < 0:
        raise RuntimeError(f"unable to locate main_graph inputs in '{input_mlir_path}'")
    inputs_end = find_matching_block(text, inputs_begin, "(", ")")
    inputs_section = text[inputs_begin + 1 : inputs_end]

    cursor = skip_whitespace(text, inputs_end + 1)
    if not text.startswith("->", cursor):
        raise RuntimeError(f"unable to locate main_graph results in '{input_mlir_path}'")
    cursor = skip_whitespace(text, cursor + 2)

    if cursor < len(text) and text[cursor] == "(":
        outputs_end = find_matching_block(text, cursor, "(", ")")
        outputs_section = text[cursor : outputs_end + 1]
        cursor = outputs_end + 1
    else:
        outputs_section, cursor = extract_single_result_section(text, cursor)

    cursor = skip_whitespace(text, cursor)
    attrs = ""
    if text.startswith("attributes", cursor):
        cursor = skip_whitespace(text, cursor + len("attributes"))
        if cursor >= len(text) or text[cursor] != "{":
            raise RuntimeError(f"unable to parse main_graph attributes in '{input_mlir_path}'")
        attrs_end = find_matching_block(text, cursor, "{", "}")
        attrs = text[cursor : attrs_end + 1]
        cursor = attrs_end + 1

    cursor = skip_whitespace(text, cursor)
    if cursor >= len(text) or text[cursor] != "{":
        raise RuntimeError(f"unable to locate main_graph body in '{input_mlir_path}'")

    input_names = re.findall(r'onnx\.name = "([^"]+)"', inputs_section)
    output_names = re.findall(r'onnx\.name = "([^"]+)"', outputs_section)
    if not input_names:
        input_names = extract_string_array_attribute(attrs, "input_names")
    if not output_names:
        output_names = extract_string_array_attribute(attrs, "output_names")
    return input_names, output_names


def filter_signatures_by_name(signatures: list[dict], expected_names: list[str], kind: str) -> list[dict]:
    by_name = {signature["name"]: signature for signature in signatures}
    filtered = []
    for name in expected_names:
        signature = by_name.get(name)
        if signature is None:
            raise RuntimeError(f"missing {kind} signature for compiler-visible tensor '{name}'")
        filtered.append(signature)
    return filtered


def build_direct_module_source(
    api_header: Path,
    entry_symbol: str,
    module_basename: str,
    input_signatures: list[dict],
    output_signatures: list[dict],
) -> str:
    entry_alias = sanitize_cpp_identifier(f"{module_basename}_entry")
    lines: list[str] = []

    for prefix, signatures in (("Input", input_signatures), ("Output", output_signatures)):
        for index, signature in enumerate(signatures):
            shape = signature.get("shape")
            if shape is None:
                raise ValueError(
                    f"{prefix.lower()} tensor '{signature.get('name', index)}' is missing rank information"
                )
            lines.append(emit_shape_array(f"k{prefix}{index}ExpectedShape", shape))

    prototype_args = []
    call_args = []
    populate_lines = []

    for prefix, signatures, tensor_expr in (
        ("Input", input_signatures, "inputs"),
        ("Output", output_signatures, "outputs"),
    ):
        for index, signature in enumerate(signatures):
            rank = len(signature["shape"])
            cpp_type = cpp_type_for_onnx_type(int(signature["element_type"]))
            desc_name = f"{prefix.lower()}_{index}"
            desc_type = f"StridedMemRefType<{cpp_type}, {rank}>"
            prototype_args.append(f"{desc_type}* {desc_name}")
            call_args.append(f"&{desc_name}")
            populate_lines.append(
                f"""  {desc_type} {desc_name}{{}};
  if (!PopulateDescriptor<{cpp_type}, {rank}>(
          {tensor_expr}[{index}],
          static_cast<uint32_t>({int(signature["element_type"])}),
          k{prefix}{index}ExpectedShape,
          {desc_name})) {{
    return -{20 + index if prefix == "Input" else 60 + index};
  }}"""
            )

    prototype = ",\n    ".join(prototype_args)
    call = ", ".join(call_args)
    populate_block = "\n\n".join(populate_lines)

    return f'''#include "{api_header}"

#include <array>
#include <cstdint>
#include <cstdlib>

namespace {{

template <typename T, size_t Rank>
struct StridedMemRefType {{
  T* allocated;
  T* aligned;
  int64_t offset;
  int64_t sizes[Rank];
  int64_t strides[Rank];
}};

template <typename T>
struct StridedMemRefType<T, 0> {{
  T* allocated;
  T* aligned;
  int64_t offset;
}};

template <typename T, size_t Rank>
bool PopulateDescriptor(const NpuxTensorView& tensor_view,
                        uint32_t expected_element_type,
                        const std::array<int64_t, Rank>& expected_shape,
                        StridedMemRefType<T, Rank>& descriptor) {{
  if (tensor_view.data == nullptr || tensor_view.element_type != expected_element_type ||
      tensor_view.rank != Rank || (Rank > 0 && tensor_view.shape == nullptr)) {{
    return false;
  }}

  descriptor.allocated = reinterpret_cast<T*>(tensor_view.data);
  descriptor.aligned = reinterpret_cast<T*>(tensor_view.data);
  descriptor.offset = 0;

  if constexpr (Rank > 0) {{
    for (size_t dim = 0; dim < Rank; ++dim) {{
      const int64_t actual_dim = tensor_view.shape[dim];
      if (actual_dim < 0) {{
        return false;
      }}
      if (expected_shape[dim] >= 0 && actual_dim != expected_shape[dim]) {{
        return false;
      }}
      descriptor.sizes[dim] = actual_dim;
    }}

    int64_t stride = 1;
    for (size_t reverse_dim = 0; reverse_dim < Rank; ++reverse_dim) {{
      const size_t dim = Rank - 1 - reverse_dim;
      descriptor.strides[dim] = stride;
      stride *= descriptor.sizes[dim];
    }}
  }}

  return true;
}}

struct ModuleState {{
  uint32_t abi_version{{NPUX_COMPILED_MODULE_ABI_VERSION}};
}};

{''.join(lines)}

extern "C" void {entry_alias}(
    {prototype}
) asm("{entry_symbol}");

}}  // namespace

extern "C" {{

int npux_module_get_abi_version(void) {{
  return NPUX_COMPILED_MODULE_ABI_VERSION;
}}

int npux_module_create(const NpuxRuntimeApi* api, void** module_state) {{
  if (api == nullptr || module_state == nullptr) {{
    return -1;
  }}
  if (api->abi_version != NPUX_COMPILED_MODULE_ABI_VERSION ||
      api->struct_size < sizeof(NpuxRuntimeApi)) {{
    return -2;
  }}

  *module_state = new ModuleState{{}};
  return 0;
}}

int npux_module_run(void* module_state,
                    const NpuxTensorView* inputs,
                    size_t num_inputs,
                    NpuxTensorView* outputs,
                    size_t num_outputs) {{
  if (module_state == nullptr || inputs == nullptr || outputs == nullptr) {{
    return -10;
  }}
  if (num_inputs != {len(input_signatures)} || num_outputs != {len(output_signatures)}) {{
    return -11;
  }}

{populate_block}

  {entry_alias}({call});
  return 0;
}}

void npux_module_destroy(void* module_state) {{
  delete static_cast<ModuleState*>(module_state);
}}

}}  // extern "C"
'''


def compile_subcommand(args: argparse.Namespace) -> int:
    if args.target != "host-sim":
        raise ValueError(f"unsupported target '{args.target}', expected host-sim")

    output_dir = Path(args.output_dir).resolve()
    output_dir.mkdir(parents=True, exist_ok=True)
    log_file = Path(args.log_file).resolve()
    log_file.parent.mkdir(parents=True, exist_ok=True)
    if log_file.exists():
        log_file.unlink()

    if not NPUX_API_HEADER.is_file():
        raise FileNotFoundError(f"missing NPUX runtime api header: {NPUX_API_HEADER}")

    with open(args.export_manifest, "r", encoding="utf-8") as f:
        export_manifest = json.load(f)

    if export_manifest.get("module_basename") != args.module_basename:
        raise ValueError("export manifest module_basename does not match requested module name")

    onnx_mlir = resolve_onnx_mlir_binary()
    compile_jobs = max(os.cpu_count() or 1, 1)
    runtime_dependencies: list[Path] = []

    with tempfile.TemporaryDirectory(prefix="npux_hostsim_direct_") as temp_dir_text:
        temp_dir = Path(temp_dir_text)
        object_base = temp_dir / args.module_basename
        compile_proc = run_command(
            [
                str(onnx_mlir),
                "--EmitObj",
                "--npux-host-sim-direct-abi",
                "--preserveMLIR",
                "--parallel",
                "-j",
                str(compile_jobs),
                "-o",
                str(object_base),
                str(Path(args.input).resolve()),
            ],
            log_file,
        )
        if compile_proc.returncode != 0:
            raise RuntimeError(f"onnx-mlir failed with exit code {compile_proc.returncode}")

        model_object = locate_generated_object(object_base)
        entry_symbol = discover_direct_entry_symbol(model_object, log_file)
        input_mlir = Path(str(object_base) + ".input.mlir")
        runtime_input_names, runtime_output_names = extract_runtime_tensor_names(input_mlir)
        runtime_input_signatures = filter_signatures_by_name(
            export_manifest["input_signatures"], runtime_input_names, "input"
        )
        runtime_output_signatures = filter_signatures_by_name(
            export_manifest["output_signatures"], runtime_output_names, "output"
        )
        direct_source = temp_dir / f"{args.module_basename}__npux_direct_module.cc"
        direct_source.write_text(
            build_direct_module_source(
                NPUX_API_HEADER,
                entry_symbol,
                args.module_basename,
                runtime_input_signatures,
                runtime_output_signatures,
            ),
            encoding="utf-8",
        )

        link_inputs = [str(direct_source), str(model_object)]
        cruntime_archive = resolve_cruntime_archive()
        if cruntime_archive is not None:
            link_inputs.append(str(cruntime_archive))

        if object_requires_openmp(model_object, log_file):
            libomp_runtime = resolve_libomp_runtime()
            if libomp_runtime is None:
                raise FileNotFoundError("unable to locate shared libomp runtime for host-sim direct ABI")
            staged_runtime = stage_shared_runtime(libomp_runtime, output_dir)
            runtime_dependencies.append(staged_runtime)
            link_inputs.append(str(staged_runtime))

        final_module = output_dir / f"{args.module_basename}.so"
        cxx = resolve_cxx()
        link_proc = run_command(
            [
                cxx,
                "-std=c++17",
                "-shared",
                "-fPIC",
                *link_inputs,
                "-o",
                str(final_module),
            ],
            log_file,
        )
        if link_proc.returncode != 0:
            raise RuntimeError(f"direct module linkage failed with exit code {link_proc.returncode}")

    compile_manifest = {
        "schema": COMPILE_MANIFEST_SCHEMA,
        "module_basename": args.module_basename,
        "module_path": str(final_module),
        "companion_library_path": "",
        "runtime_dependencies": [str(path) for path in runtime_dependencies],
        "abi_version": int(args.abi_version),
        "target": args.target,
        "compiler_id": DRIVER_VERSION,
        "graph_hash": export_manifest["graph_hash"],
        "input_signatures": runtime_input_signatures,
        "output_signatures": runtime_output_signatures,
        "input_signatures_canonical": json.dumps(runtime_input_signatures, ensure_ascii=True, separators=(",", ":")),
        "output_signatures_canonical": json.dumps(runtime_output_signatures, ensure_ascii=True, separators=(",", ":")),
        "status": "ok",
    }
    compile_manifest_path = output_dir / "compile_manifest.json"
    with compile_manifest_path.open("w", encoding="utf-8") as f:
        json.dump(compile_manifest, f, ensure_ascii=True, separators=(",", ":"))
        f.write("\n")

    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="npux-mlir-driver")
    parser.add_argument("--version", action="store_true", help="print driver version and exit")

    subparsers = parser.add_subparsers(dest="command")
    compile_parser = subparsers.add_parser("compile")
    compile_parser.add_argument("--input", required=True)
    compile_parser.add_argument("--output-dir", required=True)
    compile_parser.add_argument("--module-basename", required=True)
    compile_parser.add_argument("--target", required=True)
    compile_parser.add_argument("--abi-version", required=True)
    compile_parser.add_argument("--export-manifest", required=True)
    compile_parser.add_argument("--log-file", required=True)
    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    if args.version:
        print(DRIVER_VERSION)
        return 0
    if args.command != "compile":
        parser.print_help(sys.stderr)
        return 1
    return compile_subcommand(args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as ex:
        print(f"{DRIVER_VERSION}: {ex}", file=sys.stderr)
        sys.exit(1)
