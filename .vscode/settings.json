{
  "cmake.generator": "Ninja",
  "cmake.sourceDirectory": "${workspaceFolder}",
  "cmake.buildDirectory": "${workspaceFolder}/build",
  "cmake.configureSettings": {
    "CMAKE_CXX_COMPILER": "/usr/bin/c++",
    "CMAKE_BUILD_TYPE": "Release",
    "LLVM_ENABLE_ASSERTIONS": "ON",
    "CMAKE_CXX_STANDARD": "17",
    "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF",
    "MLIR_DIR": "/opt/llvm-project/build/lib/cmake/mlir",
    "LLVM_DIR": "/opt/llvm-project/build/lib/cmake/llvm",
    "protobuf_ABSL_PROVIDER": "package",
    "absl_DIR": "/usr/local/lib/cmake/absl",
    "protobuf_BUILD_TESTS": "OFF",
    "CMAKE_VERBOSE_MAKEFILE": "ON",
    "ONNX_MLIR_ENABLE_JAVA": "OFF",
    "ONNX_MLIR_CCACHE_BUILD": "ON",
    "CMAKE_CXX_COMPILER_LAUNCHER": "ccache" 
  },
  "cmake.environment": {
    "LD_LIBRARY_PATH": "/usr/local/lib:${env:LD_LIBRARY_PATH}"
  },
  //"cmake.buildToolArgs": ["-j", "8"],
  "cmake.copyCompileCommands": "${workspaceFolder}/compile_commands.json",
  "cmake.loggingLevel": "info"
}